discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "cloudops" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/cloudops-app"
    action        = "keep"
  }

  rule {
    target_label = "job"
    replacement  = "cloudops-app"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label  = "container"
    regex         = "/(.*)"
    replacement   = "$1"
  }
}

loki.source.docker "cloudops" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.cloudops.output
  forward_to = [loki.process.cloudops.receiver]
}

loki.process "cloudops" {
  stage.json {
    expressions = {
      level = "level",
      msg   = "msg",
    }
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}